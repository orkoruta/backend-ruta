NODE_ENV=development
PORT=3001
HOST=0.0.0.0

DATABASE_URL=postgresql://user:password@localhost:5432/ruta

JWT_SECRET=change-me-in-production
# La vida de los tokens NO se configura aquí: va por rol en
# client_parameters (auth.jwt_lifetime_<rol>_minutes y
# auth.refresh_token_lifetime_<rol>_days), fila global client_id=0.

WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_WEBHOOK_SECRET=

# Google Maps — clave de SERVIDOR para la Geocoding API.
# Restríngela por IP en Google Cloud Console. No la reutilices en el frontend:
# ahí se necesita otra clave, restringida por dominio (referrer).
GOOGLE_MAPS_API_KEY=

LOGTAIL_TOKEN=

# CORS: comma-separated list of allowed origins (frontends)
# Dev default: http://localhost:3002,http://localhost:3003
# Prod example: https://app.ruta.com,https://tienda.ruta.com
CORS_ORIGINS=http://localhost:3002,http://localhost:3003
